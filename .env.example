# PostgreSQL owner credentials used only to initialize and administer the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_ADMIN_PASSWORD

# Standard libpq variables used by the application and local psql client.
PGHOST=localhost
PGPORT=5432
PGDATABASE=enroll_dash
PGUSER=enroll_dash_app
PGPASSWORD=CHANGE_ME_TO_A_DIFFERENT_RANDOM_APP_PASSWORD
