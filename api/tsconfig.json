{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023", "DOM"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "outDir": "dist",
        "rootDir": "src",
        "allowArbitraryExtensions": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,

        /* Linting */
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": false,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src"]
}
